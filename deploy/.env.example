# ---- required ----
# Public URL of the web UI (used for OIDC redirects and cookies).
MAILR_BASE_URL=https://mail.example.com
# Generate each with:  docker compose run --rm --no-deps cli mailr gen-secret  (or openssl rand -base64 32)
MAILR_SECRET_KEY=
# Optional: a separate key that signs the single sign-on (OIDC) state. Blank = MAILR_SECRET_KEY.
MAILR_SESSION_SECRET=
POSTGRES_PASSWORD=
# Stalwart credentials: letters, digits and . _ - only (they are substituted into JSON).
STALWART_ADMIN_PASSWORD=
MAILR_SVC_PASSWORD=

# First admin account, created on first start when no users exist. It needs the password while
# MAILR_LOCAL_LOGIN=true. Remove the password once the account exists.
MAILR_BOOTSTRAP_ADMIN_EMAIL=you@example.com
MAILR_BOOTSTRAP_ADMIN_PASSWORD=

# ---- app image ----
# Default: built from this repository (the first docker compose up -d; docker compose up -d --build
# after an update). To run a published image
# instead (docker compose pull && docker compose up -d, no build), set both:
# MAILR_IMAGE=ghcr.io/murtaza-nasir/mailr:latest
# MAILR_PULL_POLICY=missing

# ---- sign-in ----
MAILR_LOCAL_LOGIN=true
MAILR_ALLOW_SIGNUP=false
# Any OIDC provider (Pocket ID, Authentik, Keycloak, Authelia...). Redirect URI:
#   ${MAILR_BASE_URL}/api/v1/auth/oidc/callback
MAILR_OIDC_ISSUER=
MAILR_OIDC_CLIENT_ID=
MAILR_OIDC_CLIENT_SECRET=
MAILR_OIDC_ADMIN_GROUP=
# Public hosts besides the issuer's own that may serve the sign-in picture, e.g. avatars.example.com,cdn.example.org
MAILR_OIDC_PICTURE_HOSTS=

# ---- models (optional; mailr works without any) ----
# JSON list seeding the admin model registry on first start. Example:
# [{"name":"local-qwen","base_url":"http://llm-host:5001/v1","locality":"local",
#   "models":["qwen3.8-27b"],"defaults":{"chat":"qwen3.8-27b","classify":"qwen3.8-27b"}}]
MAILR_SEED_MODEL_ENDPOINTS=

# ---- dictation (optional) ----
# The user's own speech server, OpenAI-compatible (/v1/audio/transcriptions), on the local network,
# e.g. WhisperX at http://asr.local:9000. Empty = off. Clips are never stored.
MAILR_ASR_URL=
# MAILR_ASR_MODEL=whisper-1
# MAILR_ASR_MAX_BYTES=8000000
# MAILR_ASR_MAX_SECONDS=120

# ---- inbox tabs (optional) ----
# Days a passed deadline still counts in a tab's Due indicator (then it drops). 0 = today on.
# MAILR_OVERDUE_DAYS=7

# ---- Ambrose's memory (optional) ----
# Cosine distance under which a note close in meaning to a request is used; 0 = measured per model.
# MAILR_MEMORY_MAX_DISTANCE=0
# Local decision model that checks candidate notes: endpoint name, empty = first local, off.
# MAILR_MEMORY_CHECK_ENDPOINT=
# MAILR_MEMORY_CHECK_MS=1500

# ---- push notifications (optional) ----
MAILR_NTFY_URL=
MAILR_NTFY_TOKEN=

# ---- monitoring (optional) ----
# Push monitor URLs (e.g. Uptime Kuma push monitors). The worker calls the first every 5 min with
# status=up or status=down, the second after a completed daily export. Empty = off.
# GET /api/v1/health/ready is the readiness endpoint for an HTTP monitor.
# MAILR_HEARTBEAT_URL=
# MAILR_BACKUP_HEARTBEAT_URL=
# Readiness checks reported but never failing /health/ready (comma-separated), e.g. export,backup_target
# MAILR_HEALTH_OPTIONAL=
# Free-space check: warn below 15 % free, fail below 5 % (the data volume and the backup target).
# MAILR_DISK_WARN_PERCENT=15
# MAILR_DISK_FAIL_PERCENT=5

# ---- logs (optional) ----
# JSON lines on standard output and in /data/logs/{app,worker}.log (10 files of 10 MB each).
# MAILR_LOG_FORMAT=json
# MAILR_LOG_FILE_MB=10
# MAILR_LOG_FILES=10

# ---- error reports (optional; admin docs, "Error reports") ----
# COMPOSE_PROFILES=errors starts GlitchTip; generate both secrets with `openssl rand -hex 32`.
# GLITCHTIP_SECRET_KEY=
# GLITCHTIP_POSTGRES_PASSWORD=
# GLITCHTIP_DOMAIN=https://errors.example.com
# GLITCHTIP_BIND=127.0.0.1
# GLITCHTIP_PORT=8027
# The DSNs of the GlitchTip projects, with the host changed to glitchtip:8000:
# MAILR_SENTRY_DSN=http://<key>@glitchtip:8000/1
# MAILR_SENTRY_BROWSER_DSN=http://<key>@glitchtip:8000/2
# MAILR_SENTRY_ENVIRONMENT=production

# ---- container limits (optional) ----
# Memory and process limits of each container (site docs, "Environment variables", Container
# limits). The defaults fit a small group; raise MAILR_PG_MEMORY with MAILR_PG_SHARED_BUFFERS.
# MAILR_APP_MEMORY=2g
# MAILR_WORKER_MEMORY=3g
# MAILR_PG_MEMORY=4g
# MAILR_STALWART_MEMORY=2g

# ---- ports / names ----
# The web port is published on loopback. If the reverse proxy runs on another machine, set
# MAILR_HTTP_BIND to this host's address on that network, and MAILR_TRUSTED_PROXIES to the
# proxy's address (only it may set X-Forwarded-For / -Proto). Left empty, loopback and the stack
# network's gateway (10.253.54.1 with the default MAILR_NET_SUBNET) are trusted, which fits a
# proxy on this host. `mailr check-config` checks this file.
MAILR_HTTP_PORT=8025
# MAILR_HTTP_BIND=127.0.0.1
# MAILR_TRUSTED_PROXIES=
MAILR_IMAPS_PORT=993
MAILR_IMAP_PORT=143
# IMAP with STARTTLS on 143 is published on loopback only; 0.0.0.0 opens it to the network.
# MAILR_IMAP_BIND=127.0.0.1
# MAILR_IMAPS_BIND=0.0.0.0
# The stack network and the app and worker addresses on it (Stalwart never bans these two).
# MAILR_NET_SUBNET=10.253.54.0/24
# MAILR_APP_IP=10.253.54.250
# MAILR_WORKER_IP=10.253.54.251
# MAILR_TRUSTED_NET=10.253.54.250/31
MAILR_IMAP_HOSTNAME=mail.example.com
# (also shown to users as the IMAP server name)
MAILR_STALWART_DOMAIN=mailr.internal

# Optional: send the image proxy's fetches through a VPN (gluetun). Enable the profile, give it a
# WireGuard key from your VPN provider (e.g. a ProtonVPN WireGuard configuration's PrivateKey),
# and point mailr at it.
# COMPOSE_PROFILES=vpn
# MAILR_VPN_PROVIDER=protonvpn
# MAILR_VPN_WIREGUARD_KEY=
# MAILR_VPN_COUNTRIES=Netherlands
# The proxy's password, letters and digits only (e.g. `openssl rand -hex 24`):
# MAILR_EGRESS_PASSWORD=
# MAILR_IMAGE_PROXY_EGRESS=http://mailr:<MAILR_EGRESS_PASSWORD>@egress:8888
# Recommended with the VPN: never fetch anything a sender chose without it (fail closed).
# MAILR_REQUIRE_EGRESS=true
# The server's own public address, for the egress check (empty = learned with one request).
# MAILR_EGRESS_FORBIDDEN_IPS=

# Optional: a headless browser for Ambrose's page readers (pages that need JavaScript). Enable the
# profile (COMPOSE_PROFILES=vpn,browser). mailr then lists the reader "Browser (server)" by itself;
# admins choose its route (through the egress proxy, or directly from this network) in
# Settings → Admin → Web search. The token: `mailr gen-secret`. The profile also starts the browser
# gate (browser-gate), the browser's only way out; its egress port uses MAILR_IMAGE_PROXY_EGRESS
# above (or MAILR_BROWSER_GATE_UPSTREAM). With MAILR_BROWSER_URL pointing at a browserless outside
# this stack, set MAILR_BROWSER_GATE= (empty).
# MAILR_BROWSER_TOKEN=
# MAILR_BROWSER_URL=http://browser:3000
# MAILR_BROWSER_ROUTE=egress

# Optional: phones and desktop calendar apps (iPhone, DAVx5, Thunderbird) on the built-in
# calendars. Enable the profile (COMPOSE_PROFILES=phones, or vpn,phones), then point a host name of
# your reverse proxy (e.g. dav.example.com) at this port, and turn phone access on in
# Settings → Admin → Calendars. See the admin docs, "Phones and desktop apps".
# MAILR_DAV_BIND=127.0.0.1
# MAILR_DAV_PORT=8026
# Your reverse proxy's address as the gateway sees it: with the proxy on this host, the stack
# network's gateway (10.253.54.1 with the default MAILR_NET_SUBNET); with the proxy on another
# machine, that machine's address (and MAILR_DAV_BIND = this host's address on that network).
# MAILR_DAV_TRUSTED_PROXY=10.253.54.1

# Second copy of the Maildir export on a mounted share (see the admin docs, "Backups").
# Create an empty file named .mailr-backup-target on the share itself. mailr copies to the share
# only while that marker is there, so an unmounted share shows as a failed backup in
# Settings → Admin → Diagnostics, never as a copy on the local disk.
# MAILR_BACKUP_DIR=/mnt/mailr-backup
# MAILR_BACKUP_TARGET=/backup
# The daily Maildir export of every user's mail. Turn it off only when the whole server or its
# volumes are backed up another way and no account is set to "Mailr keeps the mail", which needs it.
# Calendars, contacts, notes and tables are exported either way (admin docs, "Backups").
# MAILR_MAIL_EXPORT=false
# For accounts where Mailr keeps the mail, mail is deleted at the provider only once it is in that
# export (and on the backup target). With false, "Mailr keeps the mail" works without the export, and mail older than the retention
# window is deleted at the provider once it is in Mailr's mail store, with no backup check:
# backups of the mail store are then your own (admin docs, "Account modes").
# MAILR_STORE_BACKUP_CHECK=false
# A database dump is written every night to <target>/postgres (or /data/backups/postgres without a
# target), 14 kept, and before migrations when a target is set (admin docs, "Backups").
# MAILR_DB_DUMP_HOUR=9
# MAILR_DB_DUMP_KEEP=14
